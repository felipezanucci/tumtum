<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tumtum_black">

    <include layout="@layout/topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/tumtum_white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/edit_subtitle"
                android:textSize="13sp"
                android:textColor="@color/tumtum_muted" />

            <!-- Loading or failed-to-load. The form only appears with real data. -->
            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="15sp"
                android:visibility="gone"
                android:textColor="@color/tumtum_muted" />

            <LinearLayout
                android:id="@+id/form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/field_name"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/tumtum_white"
                    android:backgroundTint="@color/tumtum_muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_date"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <!-- Opens the system calendar dialog; shows dd/mm/yyyy. -->
                <TextView
                    android:id="@+id/dateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textColor="@color/tumtum_white"
                    android:background="@drawable/card_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_start"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/startHour"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:popupBackground="@color/tumtum_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=":"
                        android:textColor="@color/tumtum_muted" />

                    <Spinner
                        android:id="@+id/startMinute"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:popupBackground="@color/tumtum_black" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_end"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/endHour"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:popupBackground="@color/tumtum_black" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text=":"
                        android:textColor="@color/tumtum_muted" />

                    <Spinner
                        android:id="@+id/endMinute"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:popupBackground="@color/tumtum_black" />
                </LinearLayout>

                <!-- Only when the end reads earlier than the start. -->
                <TextView
                    android:id="@+id/midnightHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/edit_midnight"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:textColor="@color/tumtum_pink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_venue"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <EditText
                    android:id="@+id/venue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/tumtum_white"
                    android:backgroundTint="@color/tumtum_muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_city"
                    android:textSize="13sp"
                    android:textColor="@color/tumtum_muted" />

                <EditText
                    android:id="@+id/city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/tumtum_white"
                    android:backgroundTint="@color/tumtum_muted" />

                <TextView
                    android:id="@+id/saveError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:textColor="@color/tumtum_yellow" />

                <Button
                    android:id="@+id/save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:minHeight="56dp"
                    android:text="@string/save"
                    android:textColor="@color/tumtum_black"
                    android:backgroundTint="@color/tumtum_pink" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
