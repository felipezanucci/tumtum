<?xml version="1.0" encoding="utf-8"?>
<!--
  The surface the web app uses for a card on the black canvas: barely lifted
  off the background, with a hairline border doing the separating.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF0A0A0A" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#FF262626" />
</shape>
