<?xml version="1.0" encoding="utf-8"?>
<!--
  The framework's spinner item is dark text, which is invisible on this app's
  canvas. Same layout serves the closed spinner and the open list.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:textSize="16sp"
    android:background="@color/tumtum_black"
    android:textColor="@color/tumtum_white" />
