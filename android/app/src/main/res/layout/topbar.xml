<?xml version="1.0" encoding="utf-8"?>
<!--
  The one bar every screen shares: wordmark on the left, the menu on the
  right. The menu button starts gone — Chrome.wire shows it once there is a
  signed-in person for it to serve.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/tumtum_black">

    <!-- The wordmark is the way home, from anywhere. Padding keeps the touch
         target honest while the mark itself stays 22dp. -->
    <ImageView
        android:id="@+id/topLogo"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/wordmark" />

    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/menuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:gravity="center"
        android:text="@string/menu_glyph"
        android:textSize="22sp"
        android:visibility="gone"
        android:textColor="@color/tumtum_white" />
</LinearLayout>
