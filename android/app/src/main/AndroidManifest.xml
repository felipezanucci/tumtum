<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Scanning and connecting are separate permissions since Android 12, and
      neverForLocation matters: we are reading a heart rate, not a position,
      and saying so keeps the location permission out of the request entirely.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      The whole reason this app exists: a browser cannot hold a Bluetooth
      connection with the screen off, and a foreground service can. From
      Android 14 the service has to declare which kind it is, and ours is a
      connected device.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Read heart rate from Health Connect — the entire ask, and the narrowest
      one that does the job: no write, no other data type, no background
      access. On Android 13 and below the provider is a Play Store app, so it
      must also be declared visible to our package queries.
    -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".TumtumApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <!-- The front door: two seconds of heartbeat, then the capture screen. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tumtum.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reached through the splash, the menu and the capture notification;
             nothing outside the app opens it directly any more. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".EventsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SessionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".NightActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".WatchImportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!--
          Why we ask: opened by Health Connect's own permission UI, on both
          generations of the contract — the rationale intent up to Android 13,
          the permission-usage intent from Android 14. Exported because the
          caller is another app; the 14+ door additionally demands the caller
          hold START_VIEW_PERMISSION_USAGE, which only the system does.
        -->
        <activity
            android:name=".PrivacyRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:targetActivity=".PrivacyRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Kept as the net behind the native screens, reachable from them. -->
        <activity
            android:name=".ExperienceActivity"
            android:exported="false" />

        <!-- Read-only door through which the share sheet reaches a card. -->
        <provider
            android:name=".CardProvider"
            android:authorities="cc.tumtum.capture.cards"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
