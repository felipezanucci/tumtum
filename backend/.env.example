# Backend environment variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/tumtum

# Redis
REDIS_URL=redis://localhost:6379

# Database TLS: true when DATABASE_URL is a public host (asyncpg then requires ssl).
DATABASE_SSL=false

# Auth
# The server refuses to start on a placeholder or a key under 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-key
# Local stacks and CI only: lets the server start with a weak SECRET_KEY. Never on Railway.
ALLOW_WEAK_SECRET_KEY=false

# Google OAuth (for Google Fit / Health Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# External APIs
SETLIST_FM_API_KEY=
API_FOOTBALL_KEY=
# Who operates the platform: registers events, attaches a match or a setlist,
# corrects the timeline. Comma-separated. Empty closes those endpoints to
# everyone; WAITLIST_ADMIN_EMAILS counts here too.
ADMIN_EMAILS=

# "A galera": consenting nights an event needs before any collective figure is published.
CROWD_MIN_NIGHTS=100
# "A galera": the fewest people one published minute may describe.
CROWD_MIN_CELL=10
# Days a night's raw readings are kept after its moments were detected.
RAW_READINGS_RETENTION_DAYS=30

# Monitoring
SENTRY_DSN=
# "production" hides /api/demo/* entirely; "test" skips the background loops.
ENVIRONMENT=development
