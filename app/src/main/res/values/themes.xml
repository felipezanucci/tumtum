<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme principal: Compose pinta tudo; aqui só o essencial de janela. -->
    <style name="Theme.TumTum" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tt_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash §4: #FF6F91 já pintado no windowBackground — zero flash branco
         no cold start. Em API 31+ o ícone do sistema é transparente para a
         camada rosa ficar pura; o wordmark entra pelo Compose aos 120ms. -->
    <style name="Theme.TumTum.Splash" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/tt_rose</item>
        <item name="windowSplashScreenBackground">@color/tt_rose</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.TumTum</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
