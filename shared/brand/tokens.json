      "sol":          { "value": "#FFCC00", "name": "Sol",          "contrast": "13.1:1" },
      "ultravioleta": { "value": "#7A3DFF", "name": "Ultravioleta", "contrast": "3.7:1 — large text, icons and fills only" },
