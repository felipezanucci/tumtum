    },
    "functional": {
      "palco":   { "value": "#00E5FF", "name": "Palco",   "use": "Reserved for the artist/athlete line. Never decorative. 12.8:1." },
      "surface": { "value": "#15141C", "name": "Superfície" },
      "raised":  { "value": "#1F1D2A", "name": "Elevada" },
      "border":  { "value": "#2A2838", "name": "Borda" },
      "muted":   { "value": "#8A87A0", "name": "Névoa", "use": "Secondary text. 5.7:1 — the lightest grey that still passes AA." }
    },
    "carnival": {
      "acido":        { "value": "#D4FF3D", "name": "Ácido",        "contrast": "17.1:1" },
