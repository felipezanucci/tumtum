    },
    "semantic": {
      "success": { "value": "#00E676", "rule": "Always paired with an icon." },
      "warning": { "value": "#FFCC00", "rule": "Text on dark surface." },
      "error":   { "value": "#FF2E3C", "rule": "Icon plus text, never colour alone. No other red on screen." }
    },
    "print": {
