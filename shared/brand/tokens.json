  "font": {
    "display": { "family": "Bricolage Grotesque", "fallback": "Arial Black, system-ui, sans-serif", "axes": { "wdth": "75-100", "wght": "200-800", "opsz": "12-96" } },
    "text":    { "family": "Instrument Sans", "fallback": "system-ui, -apple-system, sans-serif", "weights": [400, 500, 600, 700] },
    "data":    { "family": "Martian Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace", "weights": [300, 400, 700], "features": ["tabular-nums"] }
  },
  "logo": {
    "rule": "Shape is law, fill is free.",
    "block": { "viewBox": "0 0 660 260", "stem": 58, "capHeight": 260 },
