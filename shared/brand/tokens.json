    "clearSpace": "1x on every side, where x = 58 units (the block stem thickness).",
    "minSize": { "screen": "28px block height", "nav": "20px", "favicon": "16px (icon, flat fill)", "print": "14mm", "embroidery": "30mm (seal)" }
